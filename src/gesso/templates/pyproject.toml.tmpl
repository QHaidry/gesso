[build-system]
requires = ["setuptools>=61.0", "wheel>=0.37.0"]
build-backend = "setuptools.build_meta"

[project]
name = "${app_id}"
version = "${version}"
description = "${description}"
readme = "README.md"
requires-python = ">=3.9"
dependencies = [
    "gesso-sdk[gui]",
]

[project.optional-dependencies]
dev = ["pytest>=7.0.0", "pytest-qt>=4.2.0"]

[project.scripts]
${app_id} = "${package}.main:main"

[tool.setuptools]
package-dir = { "" = "src" }
packages = { find = { where = ["src"] } }
include-package-data = true

[tool.setuptools.package-data]
${package} = ["locales/*.json", "themes/*.json"]

[tool.pytest.ini_options]
testpaths = ["tests"]
pythonpath = ["src"]
addopts = ["-ra", "-q"]
